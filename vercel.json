{
  "framework": null,
  "installCommand": "cd opstrax-supplyops-v1 && npm install",
  "buildCommand": "cd opstrax-supplyops-v1 && npm run build",
  "outputDirectory": "opstrax-supplyops-v1/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/auth/:path*"
    },
    {
      "source": "/platform/auth/:path*",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/platform/auth/:path*"
    },
    {
      "source": "/platform/login",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/platform/login"
    },
    {
      "source": "/platform/callback",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/platform/callback"
    },
    {
      "source": "/healthz",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/healthz"
    },
    {
      "source": "/healthz/ready",
      "destination": "https://YOUR_RAILWAY_DOMAIN.up.railway.app/healthz/ready"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
