{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://opstrax-ops.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://opstrax-ops.onrender.com/auth/:path*"
    },
    {
      "source": "/platform/auth/:path*",
      "destination": "https://opstrax-ops.onrender.com/platform/auth/:path*"
    },
    {
      "source": "/platform/login",
      "destination": "https://opstrax-ops.onrender.com/platform/login"
    },
    {
      "source": "/platform/callback",
      "destination": "https://opstrax-ops.onrender.com/platform/callback"
    },
    {
      "source": "/healthz",
      "destination": "https://opstrax-ops.onrender.com/healthz"
    },
    {
      "source": "/healthz/ready",
      "destination": "https://opstrax-ops.onrender.com/healthz/ready"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
